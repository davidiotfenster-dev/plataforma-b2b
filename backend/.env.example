DATABASE_URL="postgresql://fenster:fenster_dev@localhost:5433/fenster?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-largo-en-produccion"
JWT_EXPIRES_IN="8h"
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"
PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"
REDIS_URL="redis://localhost:6379"
# Envío de correos. Con EMAIL_PROVEEDOR="ses" se usa Amazon SES (región AWS_SES_REGION y
# credenciales AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, o el rol del servidor si corre en AWS).
# Sin él, Resend si hay RESEND_API_KEY. Sin ninguno, los correos solo se apuntan en el log.
EMAIL_PROVEEDOR=""
AWS_SES_REGION="eu-west-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="pedidos@iotfenster.com"
# Opcional: a dónde van las respuestas de los clientes (un buzón que alguien lea).
# EMAIL_REPLY_TO="comercial@iotfenster.com"
FRONTEND_URL="http://localhost:3000"
# Opcional: unidades compradas a partir de las cuales la ficha de un distribuidor avisa
# "¿promocionar a Partner?". Sin ponerla no sale ningún aviso (el volumen se ve igual).
# PARTNER_UMBRAL_UNIDADES=100
# Rol COMERCIAL: apagado por defecto. Con "true" los comerciales vuelven a poder entrar
# y gestionar las empresas que dieron de alta.
# COMERCIAL_ACTIVO=false
# Número de proxies (Nginx, Cloudflare, balanceador) delante del API. En producción
# detrás de un proxy, normalmente 1. Sin proxy, déjala sin definir.
# TRUST_PROXY=1
